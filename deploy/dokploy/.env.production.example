# PixelCast Signage — Dokploy production (https://pixelcast.uk)
# Copy to project root as `.env` or paste into Dokploy → Environment.
# Compose: docker-compose.prod.yml
#
# Go-live checklist:
#   1. SECRET_KEY + DB_PASSWORD (DB_PASSWORD = POSTGRES_PASSWORD)
#   2. Dokploy domain → service `frontend`, container port 80 (HTTPS On + Let's Encrypt; public 443 is Traefik)
#   3. docker network create dokploy-network  (once per host)
#   4. Deploy with build; open https://pixelcast.uk/install on first boot

# --- Django ---
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DEBUG=False
BOOTSTRAP_DEFAULT_ADMIN=false
PIXELCAST_SIGNAGE_INSTALLED=false

ALLOWED_HOSTS=pixelcast.uk,www.pixelcast.uk,frontend,backend,.traefik.me
CSRF_TRUSTED_ORIGINS=https://pixelcast.uk,https://www.pixelcast.uk
CORS_ALLOWED_ORIGINS=https://pixelcast.uk,https://www.pixelcast.uk

BASE_URL=https://pixelcast.uk
PUBLIC_WEB_APP_URL=https://pixelcast.uk

USE_BEHIND_PROXY=True
# Traefik terminates HTTPS; keep redirect off so internal healthchecks and proxy→backend HTTP work.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000

# --- Postgres (service `db`) ---
DB_NAME=pixelcast_signage_db
DB_USER=pixelcast_signage_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=db
DB_PORT=5432
USE_SQLITE=False
POSTGRES_DB=pixelcast_signage_db
POSTGRES_USER=pixelcast_signage_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CHANNEL_LAYERS_BACKEND=redis

# --- Product mode ---
DEPLOYMENT_MODE=hybrid
PLATFORM_SAAS_ENABLED=True
PLATFORM_GATEWAY_ENABLED=True
TICKET_OPERATOR_BRIDGE_ENABLED=False

LICENSE_GATEWAY_BASE_URL=
LICENSE_SERVER_URL=
LICENSE_ENFORCEMENT_ENABLED=True
USE_MOCK_REGISTRY=False

# Stripe webhook: https://pixelcast.uk/api/platform/stripe/webhook/
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

OPENWEATHER_API_KEY=
ANDROID_TV_APK_URL=

# --- Frontend build (rebuild image after any VITE_* change) ---
VITE_PUBLIC_SITE_ORIGIN=https://pixelcast.uk
VITE_PUBLIC_REGION=UK
# VITE_OG_IMAGE_URL=https://pixelcast.uk/og-default.png
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
