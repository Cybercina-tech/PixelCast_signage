# PixelCast Signage — Dokploy / production (pixelcast.uk)
# Copy to project root as `.env` on the server (or paste into Dokploy → Environment).
# Compose file: docker-compose.prod.yml
#
# Before go-live:
#   1. Replace SECRET_KEY and DB_PASSWORD (keep DB_PASSWORD = POSTGRES_PASSWORD).
#   2. Fill Stripe / OpenWeather / license gateway if you use those features.
#   3. Rebuild frontend after changing any VITE_* value.

# --- Django core ---
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DEBUG=False
BOOTSTRAP_DEFAULT_ADMIN=false
# First deploy: false → complete /install wizard. After installed.lock exists: true (optional).
PIXELCAST_SIGNAGE_INSTALLED=false

# Both public hostnames (Traefik/Dokploy terminates TLS; containers see HTTP).
ALLOWED_HOSTS=pixelcast.uk,www.pixelcast.uk,app.pixelcast.uk,frontend,backend,.traefik.me
CSRF_TRUSTED_ORIGINS=https://pixelcast.uk,https://www.pixelcast.uk,https://app.pixelcast.uk
CORS_ALLOWED_ORIGINS=https://pixelcast.uk,https://www.pixelcast.uk,https://app.pixelcast.uk

# API/media absolute URLs (use app host — same Nginx stack proxies /api and /media).
BASE_URL=https://app.pixelcast.uk
# Login, invites, Stripe return URLs, pairing QR codes.
PUBLIC_WEB_APP_URL=https://app.pixelcast.uk

USE_BEHIND_PROXY=True
SECURE_HSTS_SECONDS=31536000

# --- Database (Docker service `db`) ---
DB_NAME=pixelcast_signage_db
DB_USER=pixelcast_signage_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=db
DB_PORT=5432
USE_SQLITE=False
POSTGRES_DB=pixelcast_signage_db
POSTGRES_USER=pixelcast_signage_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Redis / Celery / Channels ---
REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CHANNEL_LAYERS_BACKEND=redis

# --- Deployment mode (adjust for your product) ---
DEPLOYMENT_MODE=hybrid
PLATFORM_SAAS_ENABLED=True
PLATFORM_GATEWAY_ENABLED=True
TICKET_OPERATOR_BRIDGE_ENABLED=False

# --- License (self-hosted / hybrid: set operator gateway URL) ---
LICENSE_GATEWAY_BASE_URL=
LICENSE_SERVER_URL=
LICENSE_ENFORCEMENT_ENABLED=True
USE_MOCK_REGISTRY=False

# --- Stripe (SaaS billing; webhook = https://app.pixelcast.uk/api/platform/stripe/webhook/ ) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Weather widget ---
OPENWEATHER_API_KEY=

# --- Optional ---
ANDROID_TV_APK_URL=
# DEPLOYMENT_STATUS_SECRET=

# --- Frontend build-time (baked into image; rebuild after changes) ---
# Marketing / SEO canonical origin (landing, blog, sitemap).
VITE_PUBLIC_SITE_ORIGIN=https://pixelcast.uk
VITE_PUBLIC_REGION=UK
# VITE_OG_IMAGE_URL=https://pixelcast.uk/og-default.png
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# Dokploy: do not publish host port 8080 publicly if Traefik uses dokploy-network only.
# HTTP_PORT is unused in prod compose (fixed 8080:80); proxy should target frontend:80 on dokploy-network.
