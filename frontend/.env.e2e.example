# Copy to .env.e2e and fill in (never commit secrets).
# Playwright loads ../.env.e2e automatically via playwright.config.js

# Match FRONTEND_HOST_PORT in root .env (4173 avoids Windows Hyper-V reserved 5141-5240).
E2E_BASE_URL=http://localhost:4173
E2E_USERNAME=
E2E_PASSWORD=
# Stripe checkout scenario is disabled by default (set 1 to enable)
E2E_ENABLE_STRIPE_CHECKOUT=0
# Optional assertion substring for returned Checkout URL
E2E_STRIPE_CHECKOUT_URL_CONTAINS=checkout.stripe.com
